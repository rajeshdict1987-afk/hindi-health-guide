# ==============================================================================
# HINDI HEALTH GUIDE (हिंदी हेल्थ गाइड) - ENVIRONMENT CONFIGURATION
# ==============================================================================
# 
# महत्वपूर्ण नोट (IMPORTANT NOTE):
# यह वेबसाइट शून्य-निर्भरता (Zero-Dependency) मोड में काम करने के लिए डिज़ाइन की गई है।
# सार्वजनिक होमपेज, सातों श्रेणियां, प्रामाणिक चिकित्सा लेख, खोज प्रणाली और अस्वीकरण
# पढ़ने के लिए किसी भी Environment Variable या बाहरी API Key की अनिवार्य आवश्यकता नहीं है।
# सभी फ़ीचर बिना किसी secret के पूरी तरह कार्य करते हैं।
# ==============================================================================

# [वैकल्पिक] 1. प्रोडक्शन वेबसाइट URL (Production App URL - OPTIONAL)
# यदि यह सेट नहीं है, तो डिफ़ॉल्ट 'https://hindihealthguide.org' स्वतः उपयोग होगा।
NEXT_PUBLIC_SITE_URL="https://hindihealthguide.org"


# [वैकल्पिक] 2. Firebase क्लाउड सिंक (Firebase Cloud Integration - OPTIONAL)
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""
# NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# [वैकल्पिक] 3. जेमिनी एआई (Gemini AI Key - OPTIONAL)
# GEMINI_API_KEY=""
