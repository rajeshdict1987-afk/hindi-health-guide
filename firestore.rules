rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'rajeshdict.1987@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isEditor() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['editor', 'admin']
      );
    }

    // Validation helper for Articles
    function isValidArticle(data) {
      return data.keys().hasAll(['id', 'title', 'slug', 'excerpt', 'content', 'categorySlug', 'status', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() >= 5 && data.title.size() <= 300 &&
        data.slug is string && data.slug.size() >= 3 && data.slug.size() <= 160 &&
        data.excerpt is string && data.excerpt.size() <= 600 &&
        data.content is string && data.content.size() >= 50 && data.content.size() <= 50000 &&
        data.categorySlug is string && data.categorySlug.size() <= 80 &&
        data.status in ['draft', 'published', 'archived'];
    }

    // 1. Articles Collection
    match /articles/{articleId} {
      allow get: if isValidId(articleId) && (
        existing().status == 'published' ||
        isEditor()
      );

      // Secure list query enforcement: public can ONLY list published articles
      allow list: if resource.data.status == 'published' || isEditor();

      allow create: if isValidId(articleId) &&
        isEditor() &&
        isValidArticle(incoming()) &&
        incoming().id == articleId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(articleId) &&
        isEditor() &&
        isValidArticle(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'slug', 'quickAnswer', 'excerpt', 'content', 'categorySlug',
            'status', 'image', 'seo', 'references', 'medicalReview',
            'readingTimeMinutes', 'featured', 'viewsCount', 'updatedAt'
          ])
        );

      allow delete: if isValidId(articleId) && isAdmin();
    }

    // 2. Categories Collection (Read-only for public, fixed 7 categories)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Editorial Reviews Collection (Doctor credentials)
    match /editorialReviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Media Collection
    match /media/{mediaId} {
      allow read: if true;
      allow create: if isValidId(mediaId) &&
        isEditor() &&
        incoming().uploadedBy == request.auth.uid &&
        incoming().sizeBytes <= 10485760; // 10MB limit
      allow update, delete: if isValidId(mediaId) &&
        (isAdmin() || (isEditor() && existing().uploadedBy == request.auth.uid));
    }

    // 5. User Profiles Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        request.auth.uid == userId &&
        incoming().role == 'reader' && // Disallow self-assignment of editor/admin role
        incoming().uid == userId;
      allow update: if isValidId(userId) &&
        (isAdmin() || (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName'])));
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 6. Site Settings
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
