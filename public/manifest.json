{
  "id": "/?source=pwa",
  "name": "हिंदी हेल्थ गाइड - Hindi Health Guide",
  "short_name": "हिंदी हेल्थ",
  "description": "भारत में वैज्ञानिक, प्रमाण-आधारित योग एवं प्रजनन स्वास्थ्य शिक्षा प्रदान करने वाली समर्पित हिंदी मंच।",
  "lang": "hi",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "orientation": "portrait-primary",
  "theme_color": "#0F172A",
  "background_color": "#ffffff",
  "categories": [
    "health",
    "medical",
    "education",
    "lifestyle",
    "news"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=org.hindihealthguide.twa",
      "id": "org.hindihealthguide.twa"
    }
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "file_handlers": [
    {
      "action": "/share-target/",
      "accept": {
        "text/plain": [".txt"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+health",
      "url": "/search?q=%s"
    }
  ],
  "share_target": {
    "action": "/share-target/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "दैनिक स्वास्थ्य टिप्स",
      "short_name": "टिप्स",
      "description": "दैनिक प्रमाणित स्वास्थ्य सुझाव",
      "tag": "health_tip",
      "template": "health-widget",
      "ms_ac_template": "/widget.json",
      "data": "/api/articles",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-mobile.png",
          "sizes": "750x1334",
          "label": "विजेट स्क्रीनशॉट"
        }
